NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/labledger?schema=public"

# Comma-separated list of browser origins allowed to call the API (the frontend URL).
# Testing on your phone over Wi-Fi? Add the LAN address too, e.g. http://192.168.1.20:3000
CORS_ORIGINS=http://localhost:3000

# Number of proxies in front of the API. Use 1 in production, where the API is
# reachable only through Caddy/Next.js. Never set it when the API is exposed
# directly — clients could then spoof their IP and bypass rate limits.
TRUST_PROXY=0

# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ISSUER=labledger-api
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

LOG_LEVEL=info

# Optional: "AI read" of serial/product numbers from label photos, using the
# Google Gemini API free tier. Create a free key at https://aistudio.google.com/apikey
# Note: on the free tier Google may use the photos to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Used only by `npm run db:seed` (initial admin account)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
